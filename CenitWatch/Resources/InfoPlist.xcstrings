{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cénit reads your heart rate, active energy and workouts on the watch during a strength session, to record it. Cénit never uploads it. No server, no account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cénit lee tu frecuencia cardiaca, tu energía activa y tus entrenamientos en el reloj durante la sesión de fuerza, para grabarla. Cénit nunca los sube. Sin servidor ni cuenta."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cénit saves your strength session into Apple Health as a workout with its active energy, on the watch and only when you allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cénit guarda tu sesión de fuerza como entrenamiento, con su energía activa, en Apple Salud, desde el reloj y solo cuando tú lo permites."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
