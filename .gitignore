# macOS / Finder cruft
.DS_Store
.AppleDouble
.localized
Icon?
# iCloud Drive can leave a duplicate copy of a synced file (e.g. "Units 2.kt") behind; a
# stray duplicate silently breaks the build with redeclared symbols, so keep those out too.
* [0-9].kt
* [0-9].swift

# Xcode / SwiftPM
# The Xcode project is generated from project.yml by XcodeGen — never commit it.
*.xcodeproj/
*.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
build/
DerivedData/
.build/
Packages/*/.build/
Tools/*/.build/
*.swiftpm
.swiftpm/
xcuserdata/
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
# Package.resolved is fine to commit; uncomment to ignore it instead:
# Package.resolved

# Build output
*.app/
Cenit.app/

# Editors
.idea/
.vscode/
*.iml

# Secrets — never commit
*.log
.env
secrets.*
# FER-722: the API key for the opt-in exercise-media downloader. The .example placeholder is
# versioned; the real file stays local-only.
Cenit/Secrets.xcconfig
!Cenit/Secrets.xcconfig.example

# Personal data — NEVER publish (real Apple Health exports, local databases)
Fixtures/
*.sqlite
*.sqlite-wal
*.sqlite-shm
export.xml
export.zip
*apple_health*.zip

# Python bytecode
__pycache__/
*.pyc

# Lazyweb design-tool scratch/cache (screenshots, references)
.lazyweb/

# Agent / tooling scratch — local only, never publish
.claude/
.stitch/
.tmp-capture/

# Design exports rescued from worktrees (local reference, not source of truth)
design-export/
